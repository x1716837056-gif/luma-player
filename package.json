{
  "name": "luma-player",
  "version": "0.1.0",
  "description": "A cinematic Windows player for your local and NAS library",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Luma",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:desktop": "npm run build && node scripts/smoke-native.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "studio.luma.player",
    "productName": "Luma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "public/luma.ico"
    },
    "asar": true
  }
}
