{
  "name": "luma-player",
  "version": "0.1.4",
  "description": "A cinematic Windows player for your local and NAS library",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Luma",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis zip --x64",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:desktop": "npm run build && node scripts/smoke-native.mjs"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "5.12.0",
    "better-sqlite3": "13.0.3",
    "chokidar": "6.0.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "opencc-js": "1.4.2",
    "p-queue": "10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tmdb-ts": "2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "studio.luma.player",
    "productName": "Luma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "THIRD-PARTY.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "icon": "public/luma.ico"
    },
    "artifactName": "Luma-${version}-Windows-${arch}.${ext}",
    "nsis": {
      "artifactName": "Luma-Windows-x64.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "electron/player",
        "to": "player",
        "filter": [
          "*.lua"
        ]
      },
      {
        "from": "tools/mpv",
        "to": "tools/mpv",
        "filter": [
          "mpv.exe",
          "d3dcompiler_43.dll",
          "LICENSE.GPL",
          "Copyright"
        ]
      },
      {
        "from": "tools/ffmpeg/ffmpeg-master-latest-win64-lgpl/bin",
        "to": "tools/ffmpeg/bin",
        "filter": [
          "ffprobe.exe"
        ]
      },
      {
        "from": "tools/ffmpeg/ffmpeg-master-latest-win64-lgpl/LICENSE.txt",
        "to": "tools/ffmpeg/LICENSE.txt"
      },
      {
        "from": "tools/mpv-build.json",
        "to": "tools/mpv-build.json"
      },
      {
        "from": "tools/ffmpeg-build.json",
        "to": "tools/ffmpeg-build.json"
      },
      {
        "from": "tools/openlist",
        "to": "tools/openlist",
        "filter": [
          "openlist.exe",
          "LICENSE",
          "SOURCE.txt"
        ]
      },
      {
        "from": "tools/openlist-build.json",
        "to": "tools/openlist-build.json"
      }
    ],
    "asarUnpack": [
      "electron/core-host.cjs",
      "electron/smb-connect.ps1"
    ]
  }
}
